# Painel do projeto no Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nunca expor no cliente — usada apenas em Route Handlers/Edge Functions (lib/supabase/admin.ts)
SUPABASE_SECRET_KEY=sb_secret_...

# URL pública do site, usada em metadata/OG/sitemap e nos redirects de auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
